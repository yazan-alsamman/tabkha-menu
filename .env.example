# Neon Postgres pooled connection string.
# Copy from https://console.neon.tech → tabkha-menu → Connection details.
DATABASE_URL=

# Public origin of the menu (used when generating QR artwork).
# Example: https://tabkha.example.com
VITE_PUBLIC_URL=

# Restaurant CMS login. Required to create the first admin on `npm run db:seed`.
# Password must be at least 10 characters.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Tabkha

# Production media storage (Vercel Blob). Locally, files go to /uploads and are served by the API.
# BLOB_READ_WRITE_TOKEN=
